{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bagrry",
  "version": "1.0.0",
  "identifier": "com.bit.bagrry",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bagrry",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost https:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Bagrry Workspace",
    "copyright": "Copyright © 2026 Bagrry Workspace. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "AI-Powered Meeting Notepad with Sentence Grounding & Verbatim Citations",
    "longDescription": "Bagrry is the production-grade local-first AI meeting notepad for Windows. Features dual-channel WASAPI loopback capture, offline speech-to-text, dual-pane editor, and cross-meeting workspace intelligence.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["en-US"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
